# Gemini API key – required for AI calls
# Prefix with VITE_ so Vite exposes it to the client
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use (must be servable by your key — verify via
# GET https://generativelanguage.googleapis.com/v1beta/models?key=KEY).
# gemini-flash-lite-latest is the verified-working default (most capacity).
# Single model only — no fallbacks, so all reviews stay comparable.
VITE_GEMINI_MODEL=gemini-flash-lite-latest

# Opt-in fallback chain (comma-separated) if the primary is overloaded.
# Empty by default = primary only.
# VITE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
